SELECT COUNT(*) AS total_rows,
       SUM(CASE WHEN date_key IS NULL THEN 1 ELSE 0 END) AS missing_date,
       SUM(CASE WHEN airline_key IS NULL THEN 1 ELSE 0 END) AS missing_airline,
       SUM(CASE WHEN aircraft_key IS NULL THEN 1 ELSE 0 END) AS missing_aircraft,
       SUM(CASE WHEN airport_key IS NULL THEN 1 ELSE 0 END) AS missing_airport
FROM gold.fact_flights;